# Local development
MONGODB_URI=
PORT=3001

# Required when NODE_ENV=production (browser sign-in for the whole app)
APP_USERNAME=
APP_PASSWORD=
# Render blueprint sets UPLOAD_DIR to a persistent disk.
# UPLOAD_DIR=/var/data/uploads

# Optional AI learning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional emergency delivery (configure all for email and SMS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
ALERT_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_PHONES=
